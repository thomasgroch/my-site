# Função de contato (functions/contact.mjs). Sem RESEND_API_KEY a função
# responde sucesso sem enviar nada, o que serve para dev e testes.
RESEND_API_KEY=
# Remetente da notificação (domínio verificado no Resend)
RESEND_FROM=Thomas Dev <contact@thomasdev.xyz>
# Para onde vai a notificação de novo contato
CONTACT_TO=contact@thomasdev.xyz

# Cypress
CYPRESS_BASE_URL=http://localhost:3000/
