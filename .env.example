# Função de contato (functions/contact.mjs). Sem MAILGUN_API_KEY a função
# responde sucesso sem enviar nada, o que serve para dev e testes.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=thomasdev.xyz
# Região EU: api.eu.mailgun.net
MAILGUN_HOST=api.mailgun.net
# Remetente dos dois e-mails
MAILGUN_FROM=Thomas Dev <contato@thomasdev.xyz>
# Para onde vai a notificação de novo contato
MAILGUN_SENDER=contato@thomasdev.xyz

# Cypress
CYPRESS_BASE_URL=http://localhost:3000/
