{
  "name": "my-awesome-portfolio",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:front": "npx vite dev --host 0.0.0.0 --port 3000 --strictPort",
    "dev:back": "netlify functions:serve --port 8888",
    "build": "npx vite build",
    "serve": "npx vite preview --port 3000",
    "start-server": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "test:unit": "vitest run --environment jsdom",
    "test:unit:dev": "vitest --environment jsdom",
    "test:e2e": "cypress run --e2e",
    "test": "npm run test:e2e:ci",
    "test:e2e:ci": "CYPRESS_BASE_URL=$DEPLOY_URL cypress run --e2e",
    "test:e2e:ci2": "npm run kill-port-3000 && CYPRESS_BASE_URL=http://localhost:3000 start-server-and-test start-server http://localhost:3000 test:e2e",
    "kill-port-3000": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.cjs,.mjs --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@heroicons/vue": "^2.0.17",
    "@jitsi/vue-sdk": "^1.0.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.14",
    "concurrently": "8.0.1",
    "date-fns": "^4.1.0",
    "handlebars": "^4.7.9",
    "nodemailer": "^6.9.1",
    "nodemailer-mailgun-transport": "^2.1.5",
    "nprogress": "0.2.0",
    "postcss": "^8.5.6",
    "stylus": "^0.59.0",
    "tailwindcss": "^3.3.1",
    "vite-plugin-environment": "^1.1.3",
    "vue": "^3.2.47",
    "vue-meta": "^3.0.0-alpha.10",
    "vue-router": "^4.1.6",
    "vue3-i18n": "1.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/tailwindcss": "^3.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "0.30.1",
    "cypress": "^14.0.1",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-vue": "^10.1.0",
    "netlify-cli": "^26.1.0",
    "netlify-plugin-checklinks": "^4.1.1",
    "node-gyp": "^13.0.0",
    "prettier": "^2.8.7",
    "prettier-plugin-tailwindcss": "^0.2.7",
    "start-server-and-test": "^2.0.0",
    "vite": "^6.0.7",
    "vitest": "^0.30.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
