{
  "name": "my-site",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n front,back \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "astro dev --host 0.0.0.0 --port 3000",
    "dev:back": "MAILGUN_API_KEY= AWS_SHARED_CREDENTIALS_FILE= AWS_CONFIG_FILE= netlify functions:serve --port 8888",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "verify": "npm run lint && npm run build && npm run test:unit && npm run check:links && npm run check:css && npm run measure",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:dev": "vitest",
    "test:e2e": "cypress run --e2e",
    "check:links": "node scripts/check-links.mjs",
    "check:css": "node scripts/check-classes.mjs",
    "measure": "node scripts/measure.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@keystar/ui": "^0.10.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "htmx.org": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shikijs/transformers": "^4.4.3",
    "concurrently": "^10.0.5",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "linkedom": "^0.18.13",
    "netlify-cli": "^27.5.1",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
