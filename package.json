{
  "name": "my-site",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n front,back \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "astro dev --host 0.0.0.0 --port 3000",
    "dev:back": "MAILGUN_API_KEY= AWS_SHARED_CREDENTIALS_FILE= AWS_CONFIG_FILE= netlify functions:serve --port 8888",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "measure": "node scripts/measure.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:dev": "vitest",
    "test:e2e": "cypress run --e2e",
    "test:e2e:ci": "CYPRESS_BASE_URL=$DEPLOY_URL cypress run --e2e",
    "lint": "eslint .",
    "prepare": "husky",
    "check:css": "node scripts/check-classes.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "htmx.org": "^4.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "netlify-cli": "^27.5.1",
    "netlify-plugin-checklinks": "^4.1.1",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
