---
const { profiles = [] } = Astro.props

// Ícones de marca inline, sem biblioteca de ícones.
const brands = {
  github: {
    label: 'GitHub',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.744.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.303-5.467-1.332-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.24 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.624-5.48 5.92.43.372.814 1.103.814 2.222 0 1.604-.015 2.897-.015 3.29 0 .322.216.696.825.577C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  gitlab: {
    label: 'GitLab',
    path: 'M12 21.42l3.68-11.32H8.32L12 21.42zM4.19 10.1l-1.13 3.48a.72.72 0 0 0 .26.8l8.68 6.3-7.81-10.58zm1.7-5.23L4.19 10.1h6.19zM19.81 10.1L18.11 4.87 16.4 10.1zM19.81 10.1h-6.19L21.31 20.4a.72.72 0 0 0 .26-.8l-1.76-5.5zm-1.7-5.23a.66.66 0 0 0-1.26 0L15.19 10.1H8.81L7.15 4.87a.66.66 0 0 0-1.26 0L4.19 10.1l7.81 10.58 7.81-10.58z',
  },
  linkedin: {
    label: 'LinkedIn',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.554V9h3.565v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
}
---
<ul class="flex justify-center gap-6 py-5">
  {profiles.map((profile) => {
    const brand = brands[profile.network]
    if (!brand) return null
    return (
      <li>
        <a href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={brand.label} title={brand.label} class="block rounded-sm text-neutral-500 hover:text-green-400">
          <svg viewBox="0 0 24 24" class="h-8 w-8 fill-current" aria-hidden="true"><path d={brand.path}></path></svg>
        </a>
      </li>
    )
  })}
</ul>
