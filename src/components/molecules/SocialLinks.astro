---
import Icon, { BRANDS } from '@/components/atoms/Icon.astro'

const { profiles = [] } = Astro.props
const known = profiles.filter((profile) => BRANDS[profile.network])
---
<ul class="cluster justify-center gap-6 py-5">
  {known.map((profile) => (
    <li>
      <a href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={BRANDS[profile.network].label} title={BRANDS[profile.network].label} class="block rounded-sm text-neutral-500 hover:text-green-400">
        <Icon name={profile.network} />
      </a>
    </li>
  ))}
</ul>
