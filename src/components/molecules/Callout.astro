---
// Aviso destacado dentro de um post. No MDX: <Callout type="tip">texto</Callout>.
const { type = 'note' } = Astro.props
const LABELS = { note: 'Note', tip: 'Tip', warning: 'Warning', danger: 'Danger' }
const kind = type in LABELS ? type : 'note'
---
<aside class="callout" data-type={kind}>
  <p class="kicker">{LABELS[kind]}</p>
  <div><slot /></div>
</aside>

<style>
  .callout {
    --tone: var(--color-info);
    margin-block: var(--space-5);
    border-inline-start: 4px solid var(--tone);
    border-start-end-radius: var(--radius-md);
    border-end-end-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--tone) 8%, transparent);
    > div {
      margin-block-start: var(--space-1);
    }
    &[data-type='tip'] {
      --tone: var(--color-accent);
    }
    &[data-type='warning'] {
      --tone: var(--color-warning);
    }
    &[data-type='danger'] {
      --tone: var(--color-error);
    }
  }
</style>
