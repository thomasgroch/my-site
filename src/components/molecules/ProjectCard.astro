---
import { Image } from 'astro:assets'
import { createTranslator } from '@/i18n'

// `item` é uma entrada validada da coleção `projects` (src/content.config.js).
const { item, locale = 'pt', eager = false } = Astro.props
const t = createTranslator(locale)
const site = item.website ?? null
const type = t(`general.project.type_${item.type}`)
---
<article class="project">
  {item.image && (
    <a href={site} target={site ? '_blank' : undefined} rel={site ? 'noopener noreferrer' : undefined} class="cover">
      <Image src={item.image} alt="" width={384} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} />
    </a>
  )}
  <div class="body">
    <h2>{site ? <a href={site} target="_blank" rel="noopener noreferrer">{item.company}</a> : item.company}</h2>
    <p class="muted">{item.position[locale]}</p>
    <p>{item.summary[locale]}</p>
    <p class="cluster foot">
      <span class="chip">{type}</span>
      <time datetime={item.startDate}>{item.startDate}</time>
    </p>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  }
  .cover {
    display: block;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    img {
      inline-size: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      object-position: top;
    }
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: 1.25rem;
    h2 {
      font-size: var(--text-lg);
      font-weight: 700;
      letter-spacing: -0.025em;
    }
  }
  .foot {
    margin-block-start: auto;
    justify-content: space-between;
    padding-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
