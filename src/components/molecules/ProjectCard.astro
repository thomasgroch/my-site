---
import { Image } from 'astro:assets'
import { createTranslator, localePath } from '@/i18n'

// `item` é uma entrada validada da coleção `projects` (src/content.config.js).
const { item, id, locale = 'pt', eager = false } = Astro.props
const t = createTranslator(locale)
const type = t(`general.project.type_${item.type}`)
const page = localePath(locale, `/projetos/${id}`)
---
<article class="project hud">
  {item.image && (
    <a href={page} class="cover" tabindex="-1" aria-hidden="true">
      <Image src={item.image} alt="" width={384} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} />
    </a>
  )}
  <div class="body">
    <h2><a href={page}>{item.company}</a></h2>
    <p class="muted position">{item.position[locale]}</p>
    <p>{item.summary[locale]}</p>
    <p class="cluster foot">
      <span class="chip">{type}</span>
      <time datetime={item.startDate}>{item.startDate}</time>
    </p>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-glow) 25%, transparent);
  }
  .cover {
    display: block;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    img {
      inline-size: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      object-position: top;
    }
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: 1.25rem;
  }
  .position {
    font-size: var(--text-base);
  }
  .foot {
    margin-block-start: auto;
    justify-content: space-between;
    padding-block-start: var(--space-3);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }
</style>
