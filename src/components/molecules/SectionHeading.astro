---
// Título de uma seção de página com a linha de apoio opcional.
const { title, description, id } = Astro.props
---
<h2 id={id} class="mb-2 text-lg font-semibold text-neutral-500 dark:text-neutral-200">{title}</h2>
{description && <p class="mb-4 text-neutral-500 dark:text-neutral-300">{description}</p>}
