---
import '@fontsource-variable/jetbrains-mono'
import '@/styles/index.css'
import TopMenu from '@/components/organisms/TopMenu.astro'
import Footer from '@/components/organisms/Footer.astro'
import { LOCALES, LOCALE_TAGS, OG_LOCALES, createTranslator, localePath } from '@/i18n'
import { THEMES } from '@/lib/themes.js'

// `path` é o caminho sem prefixo de idioma ('/', '/stack'...). O layout monta
// canonical, hreflang e os links de troca de idioma a partir dele.
// `alternates={false}` é para páginas de um idioma só (o blog): a URL não leva
// prefixo, não há hreflang e o rodapé não mostra a troca de idioma.
// `lang` é o idioma do conteúdo quando difere do da interface (um post em
// português no blog em inglês): só muda o <html lang>.
const { locale = 'pt', path = '/', title, description, noindex = false, alternates = true, ogType = 'website', lang = LOCALE_TAGS[locale] } = Astro.props
const t = createTranslator(locale)
const siteName = t('general.site_name')
const pageTitle = title ? `${title} | ${siteName}` : siteName
const metaDescription = description || t('general.meta_description_home')
const absolute = (l) => new URL(localePath(l, path), Astro.site).href
const canonical = alternates ? absolute(locale) : new URL(path, Astro.site).href
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Thomas Dev" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates && (
          <>
            {LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={absolute(l)} />)}
            <link rel="alternate" hreflang="x-default" href={absolute('pt')} />
          </>
        )}
        <link rel="sitemap" href="/sitemap-index.xml" />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Thomas Dev Blog" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#262626" media="(prefers-color-scheme: dark)" />

    <script is:inline define:vars={{ themes: THEMES }}>
      // Tema: escolha salva > preferência do sistema. Roda antes da pintura.
      // Os valores antigos (dark/light) viram matrix/light. Todo tema que não
      // é o light é escuro: a classe dark liga os efeitos de CRT e a chuva.
      ;(function () {
        var theme
        try { theme = localStorage.getItem('color-theme') } catch (e) {}
        if (theme === 'dark') theme = 'matrix'
        if (themes.indexOf(theme) < 0) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'matrix' : 'light'
        document.documentElement.dataset.theme = theme
        document.documentElement.classList.toggle('dark', theme !== 'light')
      })()
    </script>
    {locale === 'pt' ? (
      <script is:inline define:vars={{ path }}>
        // Primeira visita: segue o idioma do navegador. Qualquer visita a /en
        // grava a escolha, então isto só roda uma vez por navegador.
        ;(function () {
          try {
            if (localStorage.getItem('locale-chosen')) return
            var lang = (navigator.language || '').toLowerCase()
            if (lang.indexOf('en') === 0) location.replace('/en' + (path === '/' ? '' : path))
          } catch (e) {}
        })()
      </script>
    ) : (
      <script is:inline>
        try { localStorage.setItem('locale-chosen', '1') } catch (e) {}
      </script>
    )}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="bbe5b2be-4c67-40af-830d-61783fd70cd3"></script>
  </head>
  <body>
    <a href="#conteudo" class="skip">{t('general.skip_to_content')}</a>
    <div class="shell center">
      <TopMenu locale={locale} path={path} alternates={alternates} />
      <main id="conteudo">
        <slot />
      </main>
      <Footer locale={locale} path={path} alternates={alternates} />
    </div>

    <canvas class="rain" aria-hidden="true"></canvas>

    <script is:inline>
      // Delegação de eventos: um listener para o site inteiro, sem re-bind.
      document.addEventListener('click', function (event) {
        var menu = event.target.closest('[data-menu-toggle]')
        if (menu) {
          var open = document.getElementById('main-nav').toggleAttribute('data-open')
          menu.setAttribute('aria-expanded', String(open))
        }
      })

      // Seletor de tema da barra de status.
      var select = document.querySelector('[data-theme-select]')
      if (select) {
        select.value = document.documentElement.dataset.theme
        select.addEventListener('change', function () {
          document.documentElement.dataset.theme = select.value
          document.documentElement.classList.toggle('dark', select.value !== 'light')
          try { localStorage.setItem('color-theme', select.value) } catch (e) {}
        })
      }

      var still = matchMedia('(prefers-reduced-motion: reduce)').matches

      // Título da página digitado letra por letra. O texto completo fica no
      // aria-label, então leitores de tela não ouvem a digitação.
      var title = document.querySelector('main h1:not(.visually-hidden)')
      if (title && !still && title.children.length === 0) {
        var text = title.textContent
        title.setAttribute('aria-label', text)
        title.textContent = ''
        var i = 0
        var type = setInterval(function () {
          title.textContent = text.slice(0, ++i)
          if (i >= text.length) {
            clearInterval(type)
            title.removeAttribute('aria-label')
          }
        }, 45)
      }

      // Chuva de código no fundo, na cor de destaque do tema. Some no tema
      // claro e com movimento reduzido (o CSS esconde o canvas).
      var rain = document.querySelector('.rain')
      if (rain && !still) {
        var ctx = rain.getContext('2d')
        var size = 18
        var glyphs = 'アイウエオカキクケコサシスセソ0123456789ABCDEF<>/{}[]=+*'
        var drops = []
        var resize = function () {
          rain.width = innerWidth
          rain.height = innerHeight
          drops = Array.from({ length: Math.ceil(innerWidth / size) }, function () { return Math.random() * -50 })
        }
        resize()
        addEventListener('resize', resize)
        var last = 0
        var frame = function (now) {
          requestAnimationFrame(frame)
          if (now - last < 60 || !document.documentElement.classList.contains('dark') || document.hidden) return
          last = now
          var styles = getComputedStyle(document.documentElement)
          ctx.fillStyle = styles.getPropertyValue('--color-bg')
          ctx.globalAlpha = 0.12
          ctx.fillRect(0, 0, rain.width, rain.height)
          ctx.globalAlpha = 1
          ctx.fillStyle = styles.getPropertyValue('--color-accent')
          ctx.font = size + 'px monospace'
          drops.forEach(function (y, x) {
            ctx.fillText(glyphs[Math.floor(Math.random() * glyphs.length)], x * size, y * size)
            drops[x] = y * size > rain.height && Math.random() > 0.975 ? 0 : y + 1
          })
        }
        requestAnimationFrame(frame)
      }
    </script>
  </body>
</html>

<style>
  /* A página ocupa a tela toda, com respiro lateral que cresce com ela
     (--gutter). Textos longos limitam a própria coluna (Article, .center). */
  .shell {
    --measure: 100%;
    inline-size: calc(100% - 2 * var(--gutter));
  }

  /* Só aparece ao receber foco pelo teclado. */
  .skip {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-start: var(--space-4);
    z-index: 50;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    &:not(:focus) {
      clip-path: inset(50%);
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      white-space: nowrap;
    }
  }

</style>
