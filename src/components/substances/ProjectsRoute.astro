---
import Layout from '@/components/substances/Layout.astro'
import ProjectCard from '@/components/molecules/ProjectCard.astro'
import { getCollection } from 'astro:content'
import { createTranslator } from '@/i18n'

const { locale } = Astro.props
const t = createTranslator(locale)
// Mais recentes primeiro; no mesmo ano, vale a ordem definida no conteúdo.
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.startDate.localeCompare(a.data.startDate) || a.data.order - b.data.order
)
---
<Layout locale={locale} path="/projetos" title={t('general.nav_projects')} description={t('general.meta_description_projects')}>
  <h1 class="visually-hidden">{t('general.nav_projects')}</h1>
  <div class="grid projects">
    {projects.map((project, index) => <ProjectCard item={project.data} locale={locale} eager={index < 2} />)}
  </div>
</Layout>

<style>
  .projects {
    --min: 18rem;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }
</style>
