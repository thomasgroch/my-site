---
import Layout from '@/components/substances/Layout.astro'
import StackList from '@/components/organisms/StackList.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import { getCollection } from 'astro:content'
import { createTranslator } from '@/i18n'

const { locale } = Astro.props
const t = createTranslator(locale)

const entries = await getCollection('stack')
const group = (name) =>
  entries
    .filter((entry) => entry.data.group === name)
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => entry.data)

const sections = [
  { key: 'back', title: t('general.stack_back'), description: t('general.stack_desc_back') },
  { key: 'front', title: t('general.stack_front'), description: t('general.stack_desc_front') },
  { key: 'database', title: t('general.stack_db'), description: t('general.stack_desc_db') },
  { key: 'infra', title: t('general.stack_infra'), description: t('general.stack_desc_infra') },
  { key: 'misc', title: t('general.stack_misc'), description: t('general.stack_desc_misc') },
]
const intro = t('general.stack_intro')
const note = t('general.stack_note')
---
<Layout locale={locale} path="/stack" title={t('general.nav_stack')} description={t('general.meta_description_stack')}>
  <h1 class="visually-hidden">{t('general.nav_stack')}</h1>
  {intro && <p class="intro center muted">{intro}</p>}

  {sections.map((section) => (
    <section class="group">
      <SectionHeading title={section.title} description={section.description} />
      <StackList stack={group(section.key)} />
    </section>
  ))}
  {note && <p class="muted">{note}</p>}

  <section class="group history">
    <SectionHeading title={t('general.stack_history')} description={t('general.stack_history_description')} />
    <StackList stack={group('history')} muted />
  </section>
</Layout>

<style>
  .intro {
    --measure: 42rem;
    padding-block: var(--space-4);
    text-align: center;
    font-size: inherit;
  }
  .group {
    padding-block: var(--space-5);
  }
  .history {
    margin-block-start: var(--space-6);
    border-block-start: 1px dashed var(--color-line);
    padding-block: var(--space-6);
  }
</style>
