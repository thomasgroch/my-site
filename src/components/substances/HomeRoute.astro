---
import Layout from '@/components/substances/Layout.astro'
import Monogram from '@/components/atoms/Monogram.astro'
import SocialLinks from '@/components/molecules/SocialLinks.astro'
import { getEntry } from 'astro:content'
import { createTranslator, localePath } from '@/i18n'

const { locale } = Astro.props
const t = createTranslator(locale)
const { data: basics } = await getEntry('resume', 'basics')
const bio = t('general.profile_description').split('\n').map((s) => s.trim()).filter(Boolean)
---
<Layout locale={locale} path="/" title={t('general.nav_about')} description={t('general.meta_description_home')}>
  <section class="hero">
    <Monogram />
    <h1>{basics.name}</h1>
    <p class="muted">
      {t('general.role_profile')}, <span class="chip">{basics.label}</span>
    </p>

    <SocialLinks profiles={basics.profiles} />

    <div class="bio stack center">
      {bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <nav class="cluster actions">
      <a class="btn" href={localePath(locale, '/projetos')}>{t('general.nav_projects')}</a>
      <a class="btn" href={localePath(locale, '/contato')}>{t('general.nav_contact')}</a>
    </nav>
  </section>
</Layout>

<style>
  .hero {
    --monogram-size: 9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 2.5rem;
    text-align: center;
    color: var(--color-accent);
    h1 {
      margin-block-start: var(--space-5);
    }
    > .muted {
      margin-block-start: var(--space-2);
    }
  }
  .bio {
    --measure: 42rem;
    color: var(--color-text);
  }
  .actions {
    --gap: var(--space-4);
    margin-block-start: 2.5rem;
    justify-content: center;
    font-size: var(--text-md);
  }
  @media (min-width: 48em) {
    .hero {
      padding-block: 5rem;
    }
  }
</style>
