---
import Layout from '@/components/substances/Layout.astro'
import Article from '@/components/organisms/Article.astro'
import { render } from 'astro:content'
import { LOCALE_TAGS, createTranslator, localePath } from '@/i18n'

// Página de um projeto: um post na moldura comum. O cabeçalho vem do
// frontmatter e o corpo, o estudo de caso em português, do MDX.
const { locale, project } = Astro.props
const t = createTranslator(locale)
const { company, position, type, startDate, website, summary, stack } = project.data
const { Content } = await render(project)
const repo = website?.startsWith('https://github.com/')
---
<Layout locale={locale} path={`/projetos/${project.id}`} title={company} description={summary[locale]} ogType="article">
  <Article title={company} description={summary[locale]} lang={LOCALE_TAGS.pt} back={{ href: localePath(locale, '/projetos'), label: t('general.project.back') }}>
    <Fragment slot="meta">
      <p class="muted">{position[locale]} · {t(`general.project.type_${type}`)} · <time datetime={startDate}>{startDate}</time></p>
      {stack && <ul class="cluster tags">{stack.map((name) => <li class="chip">{name}</li>)}</ul>}
    </Fragment>

    <Content />

    {website && (
      <p slot="after"><a class="btn" href={website} target="_blank" rel="noopener noreferrer">{t(repo ? 'general.project.repo' : 'general.project.site')}</a></p>
    )}
  </Article>
</Layout>
