---
import Layout from '@/components/substances/Layout.astro'
import { getEntry } from 'astro:content'
import { createTranslator } from '@/i18n'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import lockfile from '../../../package-lock.json'

const { locale } = Astro.props
const t = createTranslator(locale)
const { data: groups } = await getEntry('meta', 'groups')

// Versão exata do que está instalado, direto do lockfile. Evita a lista
// envelhecer em silêncio quando uma dependência é atualizada.
const version = (item) => item.version ?? lockfile.packages?.[`node_modules/${item.pkg}`]?.version ?? null
---
<Layout locale={locale} path="/meta" title={t('general.meta_title')} description={t('general.meta_description_meta')}>
  <section class="colophon">
    <h1>{t('general.meta_title')}</h1>
    <p class="intro">{t('general.meta_intro')}</p>

    {groups.map((group) => (
      <section class="group">
        <SectionHeading title={group.title[locale]} description={group.intro[locale]} />

        <ul class="stack items">
          {group.items.map((item) => (
            <li>
              <p class="cluster">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.name[locale]}
                </a>
                {version(item) && (
                  <span class="chip version" data-tone="muted">
                    {version(item)}
                  </span>
                )}
              </p>
              <p class="note">{item.note[locale]}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</Layout>

<style>
  .colophon {
    padding-block: var(--space-6);
    h1 {
      color: var(--color-accent);
    }
  }
  .intro {
    margin-block-start: var(--space-4);
    max-inline-size: 42rem;
  }
  .group {
    margin-block-start: 3rem;
  }
  .items {
    list-style: none;
    padding: 0;
    li {
      border-inline-start: 2px solid var(--color-accent-soft);
      padding-inline-start: var(--space-4);
    }
    .cluster {
      --gap: var(--space-2);
      align-items: baseline;
    }
    .cluster a {
      font-weight: 500;
      color: var(--color-accent-strong);
    }
  }
  .version {
    font-size: var(--text-base);
  }
  .note {
    margin-block-start: var(--space-1);
  }
</style>
