---
import Layout from '@/components/substances/Layout.astro'
import Article from '@/components/organisms/Article.astro'
import { createTranslator, localePath } from '@/i18n'

// Página "Sobre" na moldura comum: o texto vira o corpo do post, com
// histórico e formação como seções.
const { locale } = Astro.props
const t = createTranslator(locale)
// Uma linha por parágrafo; "## Título" abre uma seção.
const lines = t('general.about.text').split('\n').filter(Boolean)
// "quando | o quê", uma linha por item.
const rows = (key) => t(key).split('\n').filter(Boolean).map((line) => line.split(' | '))
---
<Layout locale={locale} path="/sobre" title={t('general.nav_about')} description={t('general.meta_description_about')}>
  <Article title={t('general.nav_about')} description={t('general.about.subtitle')}>
    {lines.map((line) => (line.startsWith('## ') ? <h2>{line.slice(3)}</h2> : <p>{line}</p>))}

    <h2>{t('general.about.timeline_title')}</h2>
    <dl>{rows('general.about.timeline').map(([when, what]) => (<><dt><strong>{when}</strong></dt><dd>{what}</dd></>))}</dl>

    <h2>{t('general.about.education_title')}</h2>
    <dl>{rows('general.about.education').map(([when, what]) => (<><dt><strong>{when}</strong></dt><dd>{what}</dd></>))}</dl>

    <nav slot="after" class="cluster">
      <a class="btn" href={localePath(locale, '/contato')}>{t('general.about.lets_talk')}</a>
      <a class="btn" href={localePath(locale, '/projetos')}>{t('general.nav_projects')}</a>
      <a class="btn" href={localePath(locale, '/stack')}>{t('general.nav_stack')}</a>
    </nav>
  </Article>
</Layout>
