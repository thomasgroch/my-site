---
import { Image } from 'astro:assets'
import { createTranslator } from '@/i18n'

// `item` é uma entrada validada da coleção `projects` (src/content.config.js).
const { item, locale = 'pt', eager = false } = Astro.props
const t = createTranslator(locale)
// Texto no idioma da página, com o português de reserva enquanto não há tradução.
const pick = (text) => text[locale] ?? text.pt
const site = item.website ?? null
const type = t(`general.project.type_${item.type}`)
---
<article class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white shadow-md dark:border-neutral-700 dark:bg-neutral-900">
  {item.image && (
    <a href={site} target={site ? '_blank' : undefined} rel={site ? 'noopener noreferrer' : undefined} class="block bg-neutral-100 dark:bg-neutral-800">
      <Image
        src={item.image}
        alt=""
        width={384}
        densities={[1, 2]}
        loading={eager ? 'eager' : 'lazy'}
        class="aspect-video w-full object-cover object-top"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h2 class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white">
      {site ? <a href={site} target="_blank" rel="noopener noreferrer">{item.company}</a> : item.company}
    </h2>
    <p class="text-sm text-neutral-500 dark:text-neutral-400">{pick(item.position)}</p>
    <p class="text-neutral-700 dark:text-neutral-300">{pick(item.summary)}</p>
    <div class="mt-auto flex items-center justify-between pt-3 text-sm text-neutral-500">
      <span class="rounded-sm bg-green-100 px-2 py-0.5 text-green-600 dark:bg-neutral-700 dark:text-green-400">{type}</span>
      <time datetime={item.startDate}>{item.startDate}</time>
    </div>
  </div>
</article>
