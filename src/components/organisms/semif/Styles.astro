---
// Estilos da demo SemIf que ainda não viraram componente (docs/convencoes.md).
// Cada componente inclui este; o Astro emite o CSS uma vez só. Globais porque
// boa parte do HTML é montada em JS e não recebe o atributo de escopo.
---
<style is:global>
  .semif { font-size: 0.9em; line-height: 1.5; --gap: 0.85em; }

  .semif-bars { display: grid; grid-template-columns: minmax(0, 1fr) minmax(4em, 1.5fr) 3.2em; align-items: center; gap: 0.45em 0.75em; }
  .semif-bars b { font-weight: 600; }
  .semif-bars small { color: var(--color-text-muted); }
  .semif-bars em { font-style: normal; font-variant-numeric: tabular-nums; text-align: right; }
  .semif-bars .semif-top { color: var(--color-ok); }

  /* Jogos em canvas (Pac-Man, cobrinha) e o direcional para toque. */
  .semif-arcade { display: flex; justify-content: center; overflow: hidden; border-radius: 0.6rem; background: #070b14; padding: 0.5em 0; }
  .semif-arcade canvas { display: block; touch-action: none; border-radius: 0 !important; }
  .semif-pad { display: none; grid-template-columns: repeat(3, 3.2em); grid-template-areas: '. up .' 'left down right'; justify-content: center; gap: 0.35em; }
  .semif-pad button { justify-content: center; padding: 0.6em 0; font-size: 1.1em; touch-action: manipulation; }
  .semif-pad [data-dir='up'] { grid-area: up; }
  .semif-pad [data-dir='left'] { grid-area: left; }
  .semif-pad [data-dir='down'] { grid-area: down; }
  .semif-pad [data-dir='right'] { grid-area: right; }
  @media (pointer: coarse) { .semif-pad { display: grid; } }
</style>
