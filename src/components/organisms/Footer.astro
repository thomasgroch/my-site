---
import SocialLinks from '@/components/molecules/SocialLinks.astro'
import { getEntry } from 'astro:content'
import { createTranslator, localePath, LOCALES, LOCALE_NAMES, LOCALE_TAGS } from '@/i18n'

const { locale = 'pt', path = '/', alternates = true } = Astro.props
const t = createTranslator(locale)
const { data: basics } = await getEntry('resume', 'basics')
// A página 404 é uma só para todos os idiomas: o seletor leva para a home.
const switchPath = path === '/404' ? '/' : path

// Variáveis que o Netlify expõe durante o build.
const { COMMIT_REF, BRANCH, NODE_VERSION } = process.env
const repository = process.env.REPOSITORY_URL || basics.websiteRepo
---
<footer class="foot stack muted">
  {path !== '/' && <SocialLinks profiles={basics.profiles} />}

  {alternates && <nav aria-label={t('general.language')} class="cluster languages">
    {LOCALES.map((code) => (
      <a href={localePath(code, switchPath)} hreflang={LOCALE_TAGS[code]} lang={LOCALE_TAGS[code]} aria-current={code === locale ? 'true' : undefined}>
        {LOCALE_NAMES[code]}
      </a>
    ))}
  </nav>}

  <p>© 2002 - {new Date().getFullYear()} Thomas Dev · <a href={repository}>{t('general.footer_source')}</a></p>

  {COMMIT_REF && (
    <p>
      {NODE_VERSION && <span>{t('general.footer_build_with_node')} {NODE_VERSION} · </span>}
      <a href={`${repository}/commit/${COMMIT_REF}`}>#{COMMIT_REF.substring(0, 7)}</a>
      {BRANCH && <span> on <a href={`${repository}/tree/${BRANCH}`}>{BRANCH}</a></span>}
    </p>
  )}
</footer>

<style>
  .foot {
    padding-block: var(--space-6) 6rem;
    text-align: center;
    font-size: var(--text-base);
  }
  .languages {
    justify-content: center;
    a {
      border: 1px solid var(--color-line);
      border-radius: var(--radius-sm);
      padding: var(--space-1) var(--space-3);
      text-decoration: none;
      &:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }
      &[aria-current] {
        border-color: var(--color-accent);
        color: var(--color-accent-strong);
      }
    }
  }
</style>
