---
import PostMeta from '@/components/molecules/PostMeta.astro'

// Lista de posts do /blog e do /blog/drafts (este inclui os rascunhos e só
// aparece com o cookie `draft`, ver netlify/edge-functions/drafts.js).
const { posts, drafts = false } = Astro.props
---
<section class="mx-auto max-w-2xl py-8">
  <h1 class="text-3xl font-semibold text-green-400">Blog</h1>
  <p class="mt-2 flex flex-wrap gap-x-3 text-sm">
    <a href="/rss.xml">RSS feed</a>
    {drafts && <span class="text-neutral-500 dark:text-neutral-400">· drafts included, because you have the draft cookie</span>}
  </p>

  {posts.length === 0 ? (
    <p class="mt-10 text-neutral-500 dark:text-neutral-400">No posts yet.</p>
  ) : (
    <ol class="mt-10 space-y-10">
      {posts.map((post) => (
        <li>
          <article>
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <div class="mt-1"><PostMeta post={post} /></div>
            <p class="mt-2 text-neutral-600 dark:text-neutral-300">{post.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
  )}
</section>
