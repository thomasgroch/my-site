---
import PostMeta from '@/components/molecules/PostMeta.astro'

// Lista de posts do /blog e do /blog/drafts (este inclui os rascunhos e só
// aparece com o cookie `draft`, ver netlify/edge-functions/drafts.js).
const { posts, drafts = false } = Astro.props
---
<section class="posts center">
  <h1>Blog</h1>
  <p class="cluster feed">
    <a href="/rss.xml">RSS feed</a>
    {drafts && <span class="muted">· drafts included, because you have the draft cookie</span>}
  </p>

  {posts.length === 0 ? (
    <p class="muted empty">No posts yet.</p>
  ) : (
    <ol class="stack list">
      {posts.map((post) => (
        <li>
          <article class="stack">
            <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
            <PostMeta post={post} />
            <p>{post.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .posts {
    --measure: 42rem;
    padding-block: var(--space-6);
    h1 {
      font-size: var(--text-3xl);
      font-weight: 600;
      color: var(--color-accent);
    }
    h2 {
      font-size: var(--text-xl);
      font-weight: 600;
    }
  }
  .feed {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
  }
  .empty,
  .list {
    margin-block-start: 2.5rem;
  }
  .list {
    --gap: 2.5rem;
    list-style: none;
    padding: 0;
    article {
      --gap: var(--space-2);
    }
  }
</style>
