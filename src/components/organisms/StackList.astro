---
import StackCard from '@/components/molecules/StackCard.astro'
const { stack = [], muted = false } = Astro.props
---
<ul class="cluster logos">
  {stack.map((item) => <StackCard item={item} muted={muted} />)}
</ul>

<style>
  .logos {
    --gap: 0;
    justify-content: center;
    list-style: none;
    padding: 0;
  }
</style>
