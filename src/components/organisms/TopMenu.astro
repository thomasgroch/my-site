---
import Monogram from '@/components/atoms/Monogram.astro'
import { createTranslator, localePath } from '@/i18n'

const { locale = 'pt', path = '/' } = Astro.props
const t = createTranslator(locale)

const items = [
  { to: '/', label: t('general.nav_about') },
  { to: '/stack', label: t('general.nav_stack') },
  { to: '/projetos', label: t('general.nav_projects') },
  { to: '/contato', label: t('general.nav_contact') },
  // O blog é só em inglês e não tem prefixo de idioma.
  { to: '/blog', label: t('general.nav_blog'), href: '/blog' },
]
---
<header class="cluster top">
  <a href={localePath(locale, '/')} class="brand" data-home={path === '/' ? '' : undefined}>
    <Monogram decorative />
    Thomas Dev
  </a>

  <button type="button" data-menu-toggle aria-controls="main-nav" aria-expanded="false" class="burger">
    <span class="visually-hidden">{t('general.nav_open_menu')}</span>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <nav id="main-nav" class="menu">
    {items.map((item) => {
      const active = path === item.to || path.startsWith(`${item.to}/`)
      return (
        <a href={item.href ?? localePath(locale, item.to)} aria-current={active ? 'page' : undefined}>
          {item.label}
        </a>
      )
    })}
  </nav>
</header>

<style>
  .top {
    justify-content: space-between;
    padding-block: var(--space-5);
    font-size: var(--text-lg);
  }
  .brand {
    --monogram-size: 2rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    /* Na home a marca já está no centro da página; só reserva o lugar. */
    &[data-home] {
      visibility: hidden;
    }
  }
  .burger {
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    color: var(--color-accent);
    background: none;
    cursor: pointer;
    > svg {
      inline-size: 1.75rem;
      block-size: 1.75rem;
    }
  }
  /* Fechado até o botão abrir; em telas largas é uma linha, sem botão. */
  .menu {
    display: none;
    inline-size: 100%;
    flex-direction: column;
    text-align: center;
    &[data-open] {
      display: flex;
    }
    a {
      border: 2px solid transparent;
      border-radius: var(--radius-md);
      padding: var(--space-4) 1.25rem;
      color: var(--color-text-muted);
      text-decoration: none;
      &:hover {
        border-color: var(--color-accent-soft);
        color: var(--color-accent);
      }
      &[aria-current] {
        background: var(--color-accent-soft);
        color: var(--color-accent-strong);
      }
    }
  }
  @media (min-width: 40em) {
    .top {
      justify-content: center;
    }
    .brand,
    .burger {
      display: none;
    }
    .menu {
      display: flex;
      inline-size: auto;
      flex-direction: row;
      gap: var(--space-2);
      a {
        padding-block: var(--space-2);
      }
    }
  }
</style>
