---
import { LOCALES, LOCALE_NAMES, LOCALE_TAGS, createTranslator, localePath } from '@/i18n'
import { THEMES } from '@/lib/themes.js'

// Barra de status no topo, como a do nullclaw: estado, marca, navegação,
// idioma e tema numa faixa só. É a mesma em todas as páginas.
//
// O blog é só em inglês e não tem versão por idioma (alternates=false), mas
// o menu segue o idioma do resto do site: sai em português e cada item leva
// a versão em inglês em data-en-*. Layout.astro troca para ela quando a
// última página visitada fora do blog era em inglês.
const { locale = 'pt', path = '/', alternates = true } = Astro.props
const menuLocale = alternates ? locale : 'pt'
const other = LOCALES.find((code) => code !== menuLocale)
const t = createTranslator(menuLocale)
const en = createTranslator('en')

const pages = [
  { to: '/projetos', key: 'nav_projects' },
  { to: '/stack', key: 'nav_stack' },
  // O blog não tem prefixo de idioma.
  { to: '/blog', key: 'nav_blog', fixed: true },
  { to: '/sobre', key: 'nav_about' },
  { to: '/contato', key: 'nav_contact' },
]
const href = (code, page) => (page.fixed ? page.to : localePath(code, page.to))
const langPath = alternates ? (path === '/404' ? '/' : path) : '/'
---
<header class="top hud">
  <a href={localePath(menuLocale, '/')} data-en-href={alternates ? undefined : localePath('en', '/')} class="brand">
    <span class="dot" aria-hidden="true">●</span>
    <span>sys@thomas</span>
  </a>

  <button type="button" data-menu-toggle aria-controls="main-nav" aria-expanded="false" class="burger">
    <span class="visually-hidden">{t('general.nav_open_menu')}</span>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <nav id="main-nav" class="menu">
    {pages.map((page) => {
      const active = path === page.to || path.startsWith(`${page.to}/`)
      return (
        <a
          href={href(menuLocale, page)}
          data-en-href={alternates ? undefined : href('en', page)}
          data-en-label={alternates ? undefined : en(`general.${page.key}`)}
          aria-current={active ? 'page' : undefined}
        >
          {t(`general.${page.key}`)}
        </a>
      )
    })}
  </nav>

  <div class="tools">
    <a
      href={localePath(other, langPath)}
      data-en-href={alternates ? undefined : localePath('pt', '/')}
      data-en-label={alternates ? undefined : 'PT'}
      hreflang={LOCALE_TAGS[other]}
      lang={LOCALE_TAGS[other]}
      title={LOCALE_NAMES[other]}
      class="lang"
    >
      {other.toUpperCase()}
    </a>
    <label>
      <span class="visually-hidden">{t('general.theme_toggle')}</span>
      <select data-theme-select>
        {THEMES.map((name) => <option value={name}>{name}</option>)}
      </select>
    </label>
  </div>
</header>

<style>
  .top {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-line);
    padding: var(--space-2) var(--space-3);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }
  .dot {
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% { opacity: 0.35; }
  }
  .burger {
    margin-inline-start: auto;
    padding: var(--space-1);
    color: var(--color-accent);
    background: none;
    cursor: pointer;
    > svg {
      inline-size: 1.5rem;
      block-size: 1.5rem;
    }
  }
  /* Fechado até o botão abrir; em telas largas é uma linha, sem botão. */
  .menu {
    display: none;
    order: 3;
    inline-size: 100%;
    flex-direction: column;
    &[data-open] {
      display: flex;
    }
    a {
      border: 1px solid transparent;
      padding: var(--space-2) var(--space-3);
      color: var(--color-text-muted);
      text-decoration: none;
      &:hover {
        border-color: var(--color-line);
        color: var(--color-accent);
      }
      &[aria-current] {
        background: var(--color-accent);
        color: var(--color-bg);
        text-shadow: none;
        box-shadow: 0 0 16px var(--color-glow);
      }
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .lang,
  select {
    border: 1px solid var(--color-line);
    padding: var(--space-1) var(--space-2);
    font: inherit;
    color: var(--color-accent);
    background: var(--color-surface);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    &:hover {
      border-color: var(--color-accent);
    }
  }
  /* Em telas largas: três colunas iguais nas pontas e o menu no centro. As
     larguras não dependem do conteúdo da página, então a barra não se mexe. */
  @media (min-width: 52em) {
    .top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .burger {
      display: none;
    }
    .menu {
      display: flex;
      order: 0;
      inline-size: auto;
      flex-direction: row;
      gap: var(--space-1);
    }
    .tools {
      justify-self: end;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
