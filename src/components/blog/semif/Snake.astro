---
// Cobrinha jogada pelo modelo (snake.js): você assiste e pode assumir o
// controle. Funciona sem modelo: a cobra só vira ao acaso até um ser carregado.
import Styles from './Styles.astro'
import Stats from '@/components/molecules/Stats.astro'
import { SPEEDS } from './snake.js'
---
<Styles />
<div class="card stack semif" data-semif-snake>
  <div class="cluster">
    <p class="kicker">🐍 Snake, played by 🤖</p>
    <span class="muted" data-hud>🍎 0 · Best 0 · Game 1</span>
  </div>
  <div class="semif-arcade" data-wrap>
    <canvas data-canvas role="img" aria-label="Snake board. The model plays; use the arrow keys, WASD, swipes or the buttons below to take over."></canvas>
  </div>
  <div class="cluster">
    <button type="button" class="btn" data-start>▶️ Start</button>
    <button type="button" class="btn" data-variant="ghost" data-pause disabled>⏸️ Pause</button>
    <button type="button" class="btn" data-variant="ghost" data-pilot disabled>🕹️ Take over</button>
    <span class="muted">⌨️ Arrows or WASD take over · P pauses · 📱 swipe</span>
  </div>
  <label class="cluster semif-speed">
    <span>🐢</span>
    <input type="range" data-speed min={SPEEDS.min} max={SPEEDS.max} step="1" value={SPEEDS.initial} aria-label="Game speed, in steps per second" />
    <span>🐇</span>
    <span class="muted" data-speed-label>{SPEEDS.initial} steps/s</span>
  </label>
  <div class="semif-pad" data-pad>
    <button type="button" class="btn" data-variant="ghost" data-dir="up" aria-label="Up">⬆️</button>
    <button type="button" class="btn" data-variant="ghost" data-dir="left" aria-label="Left">⬅️</button>
    <button type="button" class="btn" data-variant="ghost" data-dir="down" aria-label="Down">⬇️</button>
    <button type="button" class="btn" data-variant="ghost" data-dir="right" aria-label="Right">➡️</button>
  </div>
  <Stats items={[{ label: '🧠 Brain', key: 'brain', value: '🎲 none' }, { label: '🎯 Decisions', key: 'decisions', value: '0' }, { label: '⏱️ Avg. think', key: 'think' }, { label: '⏰ Late · 🫨 reflex', key: 'lag', value: '0 · 0' }]} />
  <p class="muted" data-robot>🤖 The model is asked about a turn a few tiles ahead. If the answer is late, the snake keeps going straight, and only dodges by reflex when the next tile would kill it.</p>
</div>

<style is:global>
  .semif-speed input { flex: 1 1 8em; min-width: 0; accent-color: var(--color-green-500); }
  .semif-speed [data-speed-label] { min-width: 5.5em; font-variant-numeric: tabular-nums; }
</style>

<script>
  import { createGame, DIRECTIONS } from './snake.js'
  import { subscribe } from './engine.js'

  const KEYS = { ArrowUp: 'up', KeyW: 'up', ArrowLeft: 'left', KeyA: 'left', ArrowDown: 'down', KeyS: 'down', ArrowRight: 'right', KeyD: 'right' }

  for (const card of document.querySelectorAll('[data-semif-snake]')) {
    const $ = (selector) => card.querySelector(selector)
    const canvas = $('[data-canvas]')
    const wrap = $('[data-wrap]')
    const startButton = $('[data-start]')
    const pauseButton = $('[data-pause]')
    const pilotButton = $('[data-pilot]')
    let ended = ''

    const game = createGame(canvas, {
      onHud({ score, best, games, phase, paused, pilot, death }) {
        $('[data-hud]').textContent = `🍎 ${score} · Best ${best} · Game ${games + (phase === 'over' ? 0 : 1)}`
        const playing = phase === 'playing'
        pauseButton.disabled = !playing
        pauseButton.textContent = paused ? '▶️ Resume' : '⏸️ Pause'
        pilotButton.disabled = phase === 'idle'
        pilotButton.textContent = pilot === 'you' ? '🤖 Give it back' : '🕹️ Take over'
        startButton.textContent = phase === 'idle' ? '▶️ Start' : phase === 'over' && pilot === 'you' ? '🔁 Play again' : '🔄 Restart'
        ended = phase !== 'over' ? '' : death ? `💥 ${pilot === 'you' ? 'You' : 'The snake'} hit ${death} with ${score} 🍎. ` : '🏆 The board is full. '
      },
      onRobot({ brain, decisions, totalMs, late, reflex, ahead, last, pending, pilot }) {
        $('[data-brain]').textContent = pilot === 'you' ? '🕹️ you' : (brain ?? '🎲 none')
        $('[data-decisions]').textContent = String(decisions)
        $('[data-think]').textContent = decisions ? `${(totalMs / decisions / 1000).toFixed(2)} s` : '—'
        $('[data-lag]').textContent = `${late} · ${reflex}`
        let text
        if (pilot === 'you') {
          text = '🕹️ You are driving. Give it back to watch the model again.'
        } else if (!brain) {
          text = '🎲 No model loaded, so the snake turns at random. Load one above to give it a brain.'
        } else if (last?.probs) {
          const odds = last.options
            .map((d, i) => [d, last.probs[i]])
            .sort((a, b) => b[1] - a[1])
            .map(([d, p]) => `${d.arrow} ${Math.round(p * 100)}%`)
            .join(' · ')
          text = `${pending ? `🤔 Thinking ${ahead} ${ahead === 1 ? 'step' : 'steps'} ahead… ` : ''}Last call: ${odds} in ${(last.ms / 1000).toFixed(2)} s.`
        } else {
          text = pending ? '🤔 Thinking about the first turn…' : '🤖 Press Start to watch the model play.'
        }
        $('[data-robot]').textContent = ended + text
      },
    })

    new ResizeObserver(([entry]) => game.resize(entry.contentRect.width)).observe(wrap)
    subscribe(() => game.refresh())

    startButton.addEventListener('click', () => game.start())
    pauseButton.addEventListener('click', () => game.setPaused(!game.paused))
    pilotButton.addEventListener('click', () => game.setPilot(game.pilot === 'you' ? 'model' : 'you'))
    // Alguns navegadores devolvem o valor antigo do controle ao recarregar.
    const speed = $('[data-speed]')
    const applySpeed = () => {
      game.setSpeed(Number(speed.value))
      $('[data-speed-label]').textContent = `${speed.value} steps/s`
    }
    speed.addEventListener('input', applySpeed)
    applySpeed()
    card.querySelectorAll('[data-dir]').forEach((button) =>
      button.addEventListener('pointerdown', (event) => {
        event.preventDefault()
        game.steer(DIRECTIONS[button.dataset.dir])
      })
    )

    // As setas só são do jogo enquanto ele roda e ninguém está digitando.
    window.addEventListener('keydown', (event) => {
      if (!game.active && !game.paused) return
      if (event.target.closest?.('input, textarea, select, [contenteditable]')) return
      if (event.code === 'KeyP' || event.code === 'Escape') {
        game.setPaused(!game.paused)
        return event.preventDefault()
      }
      const dir = KEYS[event.code]
      if (!dir || game.paused) return
      event.preventDefault()
      game.steer(DIRECTIONS[dir])
    })

    let touch = null
    canvas.addEventListener('pointerdown', (event) => (touch = { x: event.clientX, y: event.clientY }))
    canvas.addEventListener('pointerup', (event) => {
      if (!touch) return
      const dx = event.clientX - touch.x
      const dy = event.clientY - touch.y
      touch = null
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 16) return
      game.steer(DIRECTIONS[Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : dy > 0 ? 'down' : 'up'])
    })

    // Pausa sozinho quando sai da tela ou a aba fica em segundo plano.
    new IntersectionObserver(([entry]) => entry.intersectionRatio < 0.3 && game.setPaused(true), { threshold: [0, 0.3] }).observe(canvas)
    document.addEventListener('visibilitychange', () => document.hidden && game.setPaused(true))
  }
</script>
