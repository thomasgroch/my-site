---
// Diz ao leitor se o navegador tem WebGPU antes de ele baixar centenas de MB.
import Styles from './Styles.astro'
import Stats from '@/components/molecules/Stats.astro'
---
<Styles />
<div class="card stack semif" data-semif-gpu>
  <p class="kicker">Your browser</p>
  <p class="status" data-status>⏳ Checking WebGPU…</p>
  <div data-details hidden>
    <Stats items={[{ label: '🎮 GPU', key: 'gpu' }, { label: '🧮 Max buffer', key: 'max-buffer' }, { label: '🔢 shader-f16', key: 'f16' }, { label: '💡 Suggested', key: 'suggested' }]} />
  </div>
</div>

<script>
  import { MODELS, isMobileDevice, recommendedModel } from './models.js'

  for (const card of document.querySelectorAll('[data-semif-gpu]')) {
    const status = card.querySelector('[data-status]')
    const details = card.querySelector('[data-details]')
    const say = (text, kind = '') => {
      status.textContent = text
      status.dataset.kind = kind
    }
    const stat = (key, value) => (details.querySelector(`[data-${key}]`).textContent = value)

    ;(async () => {
      if (!navigator.gpu) return say('❌ No WebGPU here. Try a recent Chrome, Edge or Safari, over HTTPS.', 'error')
      const adapter = await navigator.gpu.requestAdapter()
      if (!adapter) return say('⚠️ WebGPU exists, but the browser gave no GPU adapter. It may be blocklisted or disabled.', 'error')
      const info = adapter.info ?? {}
      const gpu = [info.vendor, info.architecture].filter(Boolean).join(' · ') || 'hidden by the browser'
      say('✅ WebGPU is ready. Nothing downloads until you press load.', 'ok')
      stat('gpu', gpu)
      stat('max-buffer', `${Math.round(adapter.limits.maxBufferSize / 1024 ** 2)} MB`)
      stat('f16', adapter.features.has('shader-f16') ? 'yes' : 'no')
      stat('suggested', `${isMobileDevice() ? '📱' : '💻'} ${MODELS[recommendedModel()].name}`)
      details.hidden = false
    })().catch((error) => say(`❌ WebGPU check failed: ${error.message}`, 'error'))
  }
</script>
