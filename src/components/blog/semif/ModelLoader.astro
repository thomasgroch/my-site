---
// Escolha, carga e troca do modelo. Um por vez: o laboratório e o jogo usam o
// mesmo (engine.js). Com prefer="fast", começa no menor modelo em qualquer
// aparelho: no Pac-Man, latência importa mais que acerto.
import Styles from './Styles.astro'
import Stats from '@/components/molecules/Stats.astro'
import { MODELS } from './models.js'

const { prefer } = Astro.props
---
<Styles />
<div class="card stack semif" data-semif-loader data-prefer={prefer}>
  <p class="kicker">Model</p>
  <div class="cluster">
    <select data-model class="rounded-lg border-neutral-300 bg-transparent py-1.5 text-[0.95em] dark:border-neutral-600">
      {Object.entries(MODELS).map(([id, model]) => <option value={id}>{model.name} · {model.size}</option>)}
    </select>
    <button type="button" class="btn" data-load>⬇️ Load</button>
  </div>
  <p class="muted" data-notice></p>
  <div>
    <div class="cluster muted"><span>📦 Download</span><span data-percent>—</span></div>
    <div class="meter"><i data-meter></i></div>
  </div>
  <Stats items={[{ label: '⏱️ Model load', key: 'load-time' }, { label: '🔥 Warmup', key: 'warmup' }]} />
  <p class="status" data-status>💤 No model loaded. Everything runs on your GPU; nothing is sent anywhere.</p>
</div>

<script>
  import { MODELS, recommendedModel } from './models.js'
  import { load, seconds, status, subscribe } from './engine.js'

  for (const card of document.querySelectorAll('[data-semif-loader]')) {
    const $ = (selector) => card.querySelector(selector)
    const select = $('[data-model]')
    const button = $('[data-load]')
    const say = (text, kind = '') => {
      $('[data-status]').textContent = text
      $('[data-status]').dataset.kind = kind
    }
    // Dá para trocar de modelo sem recarregar a página: o botão só trava
    // durante a carga e enquanto o modelo escolhido já é o que está carregado.
    const render = () => {
      const model = MODELS[select.value]
      const loading = status.state === 'loading'
      const current = status.state === 'ready' && status.modelId === select.value
      $('[data-notice]').textContent = model.notice
      select.disabled = loading || !navigator.gpu
      button.disabled = loading || current || !navigator.gpu
      button.textContent = loading ? '⏳ Loading…' : current ? '✅ Ready' : `${status.state === 'ready' ? '🔁 Switch to' : '⬇️ Load'} ${model.name} (${model.size})`
    }

    select.value = card.dataset.prefer === 'fast' ? 'qwen3-0.6b' : recommendedModel()
    select.addEventListener('change', render)

    if (!navigator.gpu) say('❌ This browser has no WebGPU, so the model cannot load.', 'error')

    subscribe(({ state, name, error }) => {
      render()
      if (state === 'ready') say(`✅ ${name} is loaded on your GPU. Scroll down and try it.`, 'ok')
      if (state === 'error') say(`❌ ${error}`, 'error')
    })

    button.addEventListener('click', async () => {
      say('📡 Fetching the model, or reading it from the browser cache…')
      $('[data-meter]').style.width = '0%'
      for (const key of ['percent', 'load-time', 'warmup']) $(`[data-${key}]`).textContent = '—'
      try {
        const result = await load(select.value, (event) => {
          if (event.phase === 'download' && event.total) {
            const percent = Math.min(100, (event.loaded / event.total) * 100)
            $('[data-meter]').style.width = `${percent}%`
            $('[data-percent]').textContent = `${percent.toFixed(0)}%`
          }
          if (event.phase === 'warmup') {
            $('[data-meter]').style.width = '100%'
            $('[data-load-time]').textContent = seconds(event.loadMs)
            say('🔥 Loaded. Compiling shaders with one warmup pass…')
          }
        })
        $('[data-warmup]').textContent = seconds(result.warmupMs)
      } catch {
        // O estado de erro já foi publicado pelo engine.js.
      }
    })
  }
</script>
