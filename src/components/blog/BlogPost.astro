---
import { Image } from 'astro:assets'
import { formatDate, readingTime, tableOfContents } from '@/lib/blog.js'

// Moldura de um post: cabeçalho, capa, sumário e o conteúdo no <slot />.
// Os estilos de leitura abaixo só entram nas páginas de post.
const { post, headings = [], series = [] } = Astro.props
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data
// Posição deste post na série (ver seriesOf em src/lib/blog.js).
const part = series.findIndex((entry) => entry.id === post.id)
const next = series[part + 1]
const { minutes } = readingTime(post.body)
const toc = tableOfContents(headings)
---
<article class="post mx-auto py-8">
  <header>
    <p class="text-sm"><a href="/blog">All posts</a></p>
    <h1 class="mt-4 text-3xl font-semibold text-neutral-900 dark:text-white">{title}</h1>
    <p class="mt-3 text-neutral-600 dark:text-neutral-300">{description}</p>
    <p class="mt-4 flex flex-wrap gap-x-3 text-sm text-neutral-500 dark:text-neutral-400">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
      {updatedDate && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
        </>
      )}
      {draft && (
        <>
          <span aria-hidden="true">·</span>
          <span class="rounded-sm bg-yellow-100 px-1.5 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-100">Draft</span>
        </>
      )}
    </p>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-sm bg-green-100 px-2 py-0.5 text-sm text-green-600 dark:bg-neutral-700 dark:text-green-400">{tag}</li>
        ))}
      </ul>
    )}
  </header>

  {cover && <Image src={cover} alt={coverAlt ?? ''} width={768} densities={[1, 2]} loading="eager" class="mt-8 w-full rounded-lg" />}

  {series.length > 1 && (
    <nav aria-label="Series" class="mt-8 rounded-lg border border-green-400/40 bg-green-400/5 p-4">
      <p class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">
        Series: {post.data.series} · Part {part + 1} of {series.length}
      </p>
      <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm marker:text-green-400">
        {series.map((entry) => (
          <li>
            {entry.id === post.id
              ? <span aria-current="page" class="font-semibold">{entry.data.title}</span>
              : <a href={`/blog/${entry.id}`}>{entry.data.title}</a>}
          </li>
        ))}
      </ol>
    </nav>
  )}

  {toc.length > 1 && (
    <nav aria-label="Contents" class="mt-8 rounded-lg border border-neutral-200 p-4 dark:border-neutral-700">
      <p class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Contents</p>
      <ol class="mt-2 space-y-1 text-sm">
        {toc.map((heading) => (
          <li class:list={[{ 'pl-4': heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <div class="post-content mt-8"><slot /></div>

  {next && (
    <p class="mt-12 border-t border-neutral-200 pt-6 dark:border-neutral-700">
      <span class="text-sm text-neutral-500 dark:text-neutral-400">Next in {post.data.series}</span><br />
      <a href={`/blog/${next.id}`} class="font-semibold">{next.data.title} →</a>
    </p>
  )}
</article>

<style is:global>
  /* Leitura: 17→20px conforme a tela, ~68 caracteres por linha. A largura em
     em acompanha o tamanho da fonte do próprio artigo. */
  .post { font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.25rem); max-width: 34em; }
  .post-content { line-height: 1.65; }
  .post-content p { font-weight: 400; line-height: inherit; }
  .post-content > * + * { margin-top: 1.25em; }
  .post-content :is(h2, h3, h4) { line-height: 1.25; font-weight: 600; text-wrap: balance; scroll-margin-top: 1.5rem; }
  .post-content h2 { margin-top: 2.25em; font-size: 1.5em; }
  .post-content h3 { margin-top: 1.75em; font-size: 1.25em; }
  .post-content h4 { margin-top: 1.5em; font-size: 1em; }
  .post-content :is(h2, h3, h4) + * { margin-top: 0.75em; }
  .post-content a { text-decoration-thickness: 0.08em; text-underline-offset: 0.2em; }

  .post-content ul { list-style: disc; padding-left: 1.5em; }
  .post-content ol { list-style: decimal; padding-left: 1.5em; }
  .post-content li + li, .post-content li > ul { margin-top: 0.35em; }
  .post-content li::marker { color: var(--color-green-400); }
  .post-content .contains-task-list { list-style: none; padding-left: 0.25em; }
  .post-content .task-list-item input { margin: 0 0.5em 0.2em 0; border-radius: 0.2em; color: var(--color-green-400); }

  .post-content blockquote { border-left: 3px solid var(--color-green-400); border-radius: 0 0.5rem 0.5rem 0; background: rgb(74 222 128 / 0.07); padding: 0.75em 1.25em; }
  .post-content blockquote > * + * { margin-top: 0.75em; }
  .post-content blockquote cite { font-size: 0.9em; font-style: normal; color: var(--color-neutral-500); }

  .post-content hr { margin-block: 2.5em; border-color: rgb(0 0 0 / 0.1); }
  .post-content img, .post-content iframe { border-radius: 0.5rem; }
  .post-content figcaption { margin-top: 0.6em; text-align: center; font-size: 0.85em; color: var(--color-neutral-500); }
  .post-content .embed iframe { display: block; width: 100%; border: 1px solid rgb(0 0 0 / 0.1); background: white; }

  /* Sai da coluna quando há espaço; em telas estreitas ocupa a largura toda. */
  .post-content .wide { --w: min(calc(100vw - 2rem), 60rem); width: var(--w); max-width: none; margin-inline: calc((100% - var(--w)) / 2); }
  .post-content .wide img { width: 100%; }

  .post-content table { width: 100%; border-collapse: collapse; font-size: 0.9em; font-variant-numeric: tabular-nums; }
  .post-content th, .post-content td { border-bottom: 1px solid rgb(0 0 0 / 0.12); padding: 0.5em 0.75em; }
  .post-content th { font-weight: 600; border-bottom-width: 2px; }

  .post-content :not(pre) > code { border-radius: 0.25rem; background: rgb(0 0 0 / 0.06); padding: 0.1em 0.35em; font-size: 0.85em; }
  .post-content kbd { border: 1px solid rgb(0 0 0 / 0.2); border-bottom-width: 2px; border-radius: 0.25rem; padding: 0.05em 0.4em; font-family: var(--font-mono); font-size: 0.8em; }
  .post-content mark { border-radius: 0.2em; background: rgb(74 222 128 / 0.3); padding: 0 0.15em; color: inherit; }
  .post-content abbr[title] { text-decoration: underline dotted; cursor: help; }
  .post-content :is(sub, sup) { line-height: 0; }

  .post-content details { border: 1px solid rgb(0 0 0 / 0.12); border-radius: 0.5rem; padding: 0.75em 1em; }
  .post-content summary { cursor: pointer; font-weight: 600; }
  .post-content details[open] summary { margin-bottom: 0.75em; }

  .post-content .footnotes { margin-top: 3em; border-top: 1px solid rgb(0 0 0 / 0.1); padding-top: 1em; font-size: 0.85em; }
  .post-content .footnotes h2 { margin-top: 0; font-size: 1em; }
  .post-content .footnotes li + li { margin-top: 0.5em; }
  .post-content [data-footnote-ref] { text-decoration: none; font-weight: 600; }

  /* Blocos de código: cabeçalho gerado em src/lib/shiki.js. */
  .post-content .code-block { overflow: hidden; border: 1px solid rgb(0 0 0 / 0.1); border-radius: 0.75rem; }
  .post-content .code-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(0 0 0 / 0.1); padding: 0.35em 0.5em 0.35em 1em; font-family: var(--font-mono); font-size: 0.75em; color: var(--color-neutral-500); }
  .post-content .code-lang { text-transform: lowercase; }
  .post-content .code-title { color: inherit; font-weight: 600; }
  .post-content .code-copy { border-radius: 0.25rem; padding: 0.2em 0.6em; }
  .post-content .code-copy:hover { background: rgb(0 0 0 / 0.06); }
  .post-content pre { overflow-x: auto; padding: 1em 0; font-size: 0.85em; line-height: 1.6; }
  .post-content pre code { display: block; min-width: max-content; }
  .post-content pre .line { display: inline-block; width: 100%; padding-inline: 1.25em; }
  .post-content pre .line.highlighted { background: rgb(74 222 128 / 0.12) !important; box-shadow: inset 3px 0 var(--color-green-400); }
  .post-content pre .line.diff.add { background: rgb(34 197 94 / 0.14) !important; }
  .post-content pre .line.diff.remove { background: rgb(239 68 68 / 0.14) !important; opacity: 0.8; }
  .post-content pre .line.diff.add::before { content: '+'; margin-left: -1em; position: absolute; color: rgb(22 163 74); }
  .post-content pre .line.diff.remove::before { content: '−'; margin-left: -1em; position: absolute; color: rgb(220 38 38); }

  html.dark .post-content :not(pre) > code, html.dark .post-content .code-copy:hover { background: rgb(255 255 255 / 0.1); }
  html.dark .post-content :is(hr, th, td, details, .footnotes, .code-block, .code-header, .embed iframe) { border-color: rgb(255 255 255 / 0.15); }
  html.dark .post-content kbd { border-color: rgb(255 255 255 / 0.25); }
  html.dark .post-content :is(figcaption, .code-header) { color: var(--color-neutral-400); }

  /* Código com dois temas do Shiki (astro.config.mjs, defaultColor: false):
     segue a classe `dark` do site, não a preferência do sistema. */
  .astro-code, .astro-code span {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
    text-decoration: var(--shiki-light-text-decoration);
  }
  html.dark .astro-code, html.dark .astro-code span {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
    font-style: var(--shiki-dark-font-style);
    font-weight: var(--shiki-dark-font-weight);
    text-decoration: var(--shiki-dark-text-decoration);
  }
</style>

<script>
  // Botão "Copy" dos blocos de código (src/lib/shiki.js).
  document.addEventListener('click', async (event) => {
    const button = event.target.closest('.code-copy')
    if (!button) return
    const code = button.closest('.code-block').querySelector('pre').innerText
    await navigator.clipboard.writeText(code)
    button.textContent = 'Copied'
    setTimeout(() => { button.textContent = 'Copy' }, 1500)
  })
</script>
