---
import { Image } from 'astro:assets'
import { formatDate, readingTime, tableOfContents } from '@/lib/blog.js'

// Moldura de um post: cabeçalho, capa, sumário e o conteúdo no <slot />.
// Os estilos de leitura abaixo só entram nas páginas de post.
const { post, headings = [] } = Astro.props
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data
const { minutes } = readingTime(post.body)
const toc = tableOfContents(headings)
---
<article class="mx-auto max-w-2xl py-8">
  <header>
    <p class="text-sm"><a href="/blog">All posts</a></p>
    <h1 class="mt-4 text-3xl font-semibold text-neutral-900 dark:text-white">{title}</h1>
    <p class="mt-3 text-neutral-600 dark:text-neutral-300">{description}</p>
    <p class="mt-4 flex flex-wrap gap-x-3 text-sm text-neutral-500 dark:text-neutral-400">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
      {updatedDate && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
        </>
      )}
      {draft && (
        <>
          <span aria-hidden="true">·</span>
          <span class="rounded-sm bg-yellow-100 px-1.5 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-100">Draft</span>
        </>
      )}
    </p>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-sm bg-green-100 px-2 py-0.5 text-sm text-green-600 dark:bg-neutral-700 dark:text-green-400">{tag}</li>
        ))}
      </ul>
    )}
  </header>

  {cover && <Image src={cover} alt={coverAlt ?? ''} width={768} densities={[1, 2]} loading="eager" class="mt-8 w-full rounded-lg" />}

  {toc.length > 1 && (
    <nav aria-label="Contents" class="mt-8 rounded-lg border border-neutral-200 p-4 dark:border-neutral-700">
      <p class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Contents</p>
      <ol class="mt-2 space-y-1 text-sm">
        {toc.map((heading) => (
          <li class:list={[{ 'pl-4': heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <div class="post-content mt-8"><slot /></div>
</article>

<style is:global>
  .post-content { line-height: 1.75; }
  .post-content > * + * { margin-top: 1.25em; }
  .post-content h2 { margin-top: 2em; font-size: 1.5rem; font-weight: 600; }
  .post-content h3 { margin-top: 1.5em; font-size: 1.25rem; font-weight: 600; }
  .post-content h2 + *, .post-content h3 + * { margin-top: 0.75em; }
  .post-content ul { list-style: disc; padding-left: 1.5em; }
  .post-content ol { list-style: decimal; padding-left: 1.5em; }
  .post-content li + li { margin-top: 0.35em; }
  .post-content blockquote { border-left: 3px solid rgb(74 222 128); padding-left: 1em; font-style: italic; }
  .post-content hr { border-color: rgb(0 0 0 / 0.1); }
  .post-content img { border-radius: 0.5rem; }
  .post-content table { width: 100%; border-collapse: collapse; font-size: 0.95em; }
  .post-content th, .post-content td { border: 1px solid rgb(0 0 0 / 0.12); padding: 0.4em 0.6em; text-align: left; }
  .post-content :not(pre) > code { border-radius: 0.25rem; background: rgb(0 0 0 / 0.06); padding: 0.1em 0.35em; font-size: 0.9em; }
  .post-content pre { overflow-x: auto; border-radius: 0.5rem; padding: 1rem; font-size: 0.9rem; line-height: 1.6; }
  html.dark .post-content :not(pre) > code { background: rgb(255 255 255 / 0.1); }
  html.dark .post-content hr { border-color: rgb(255 255 255 / 0.15); }
  html.dark .post-content th, html.dark .post-content td { border-color: rgb(255 255 255 / 0.15); }

  /* Código com dois temas do Shiki (astro.config.mjs, defaultColor: false):
     segue a classe `dark` do site, não a preferência do sistema. */
  .astro-code, .astro-code span {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
    text-decoration: var(--shiki-light-text-decoration);
  }
  html.dark .astro-code, html.dark .astro-code span {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
    font-style: var(--shiki-dark-font-style);
    font-weight: var(--shiki-dark-font-weight);
    text-decoration: var(--shiki-dark-text-decoration);
  }
</style>
