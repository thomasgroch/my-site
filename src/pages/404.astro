---
import Layout from '@/components/substances/Layout.astro'
import { LOCALES, LOCALE_TAGS, createTranslator, localePath } from '@/i18n'

// O Netlify serve este arquivo para qualquer URL desconhecida, então a página
// carrega os dois idiomas e mostra o que combina com o prefixo da URL.
// O "404" fica fora dessa troca: é o mesmo em qualquer idioma e serve como
// título único da página.
---
<Layout locale="pt" path="/404" title="404" noindex>
  <section class="lost">
    <h1>404</h1>
    {LOCALES.map((locale) => {
      const t = createTranslator(locale)
      return (
        <div data-locale={locale} lang={LOCALE_TAGS[locale]} hidden={locale !== 'pt'}>
          <p class="message">{t('general.nothing_here')}</p>
          <p class="action"><a class="btn" href={localePath(locale, '/')}>{t('general.goto_site')}</a></p>
        </div>
      )
    })}
  </section>
  <script is:inline>
    ;(function () {
      var match = location.pathname.match(/^\/(en)(\/|$)/)
      if (!match) return
      document.querySelectorAll('[data-locale]').forEach(function (el) {
        el.hidden = el.dataset.locale !== match[1]
      })
    })()
  </script>
</Layout>

<style>
  .lost {
    padding-block: var(--space-6);
    text-align: center;
    h1 {
      font-size: 8rem;
      line-height: 1;
      color: var(--color-accent);
    }
  }
  .message {
    margin-block-start: var(--space-4);
    font-size: var(--text-2xl);
  }
  .action {
    margin-block-start: 2.5rem;
    font-size: var(--text-md);
  }
</style>
