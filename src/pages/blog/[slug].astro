---
import Layout from '@/layouts/Layout.astro'
import BlogPost from '@/components/blog/BlogPost.astro'
import Callout from '@/components/blog/Callout.astro'
import Wide from '@/components/blog/Wide.astro'
import Embed from '@/components/blog/Embed.astro'
import { getCollection, render } from 'astro:content'
import { isVisible, seriesOf } from '@/lib/blog.js'

export async function getStaticPaths() {
  const posts = await getCollection('blog', isVisible)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, series: seriesOf(post, posts) } }))
}

const { post, series } = Astro.props
const { Content, headings } = await render(post)
---
<Layout
  locale="en"
  path={`/blog/${post.id}`}
  alternates={false}
  noindex={post.data.draft}
  ogType="article"
  title={post.data.title}
  description={post.data.description}
>
  <BlogPost post={post} headings={headings} series={series}>
    <Content components={{ Callout, Wide, Embed }} />
  </BlogPost>
</Layout>
