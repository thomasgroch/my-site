---
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/blog/PostList.astro'
import { getCollection } from 'astro:content'
import { byNewest, isListed } from '@/lib/blog.js'

// Blog só em inglês: URL sem prefixo de idioma e sem versões alternativas.
// Com o cookie `draft`, a Edge Function serve /blog/drafts no lugar desta.
const posts = (await getCollection('blog', isListed)).sort(byNewest)
---
<Layout locale="en" path="/blog" alternates={false} title="Blog" description="Posts about web development by Thomas Dev.">
  <PostList posts={posts} />
</Layout>
